# Credenciales de Firebase.
#
# Copia este archivo a `.env` y pon los valores reales del proyecto.
# `.env` está en .gitignore: nunca se sube al repositorio.
#
# Nota: en Firebase Web estas claves son públicas por diseño — la seguridad real
# está en las reglas de Firestore, no en esconderlas. Aun así van en variables de
# entorno para no tenerlas incrustadas en el código y poder cambiar de proyecto
# sin tocar los fuentes.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
